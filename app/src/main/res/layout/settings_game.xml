<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background"
    android:padding="24dp"
    tools:ignore="TextSizeCheck">

    <TextView
        android:id="@+id/tv_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pokemon_font"
        android:text="SETTINGS"
        android:textColor="#4E342E"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <GridLayout
        android:id="@+id/grid_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title">

        <Button
            android:id="@+id/btn_settings_sound"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#8D6E63"
            android:fontFamily="@font/pokemon_font"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="Sound: On"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btn_settings_replay"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#8D6E63"
            android:fontFamily="@font/pokemon_font"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="Replay"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btn_settings_home"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#D84315"
            android:fontFamily="@font/pokemon_font"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="Main Menu"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:ignore="HardcodedText,TextContrastCheck" />
    </GridLayout>

    <Button
        android:id="@+id/btn_settings_resume"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#4CAF50"
        android:fontFamily="@font/pokemon_font"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:text="RESUME"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/grid_settings"
        tools:ignore="HardcodedText,TextContrastCheck"
        tools:layout_editor_absoluteX="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>